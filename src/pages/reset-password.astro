---
// src/pages/reset-password.astro — set a new password from an emailed reset link.
// Requesting the link happens inline on /login; this page only handles the
// follow-through after the user clicks that link.
import Layout from '../layouts/Layout.astro';
import { ResetPasswordScreen } from '../components/auth/ResetPasswordScreen.tsx';

const url = new URL(Astro.request.url);
const mode = url.searchParams.get('mode');
const token = url.searchParams.get('token');
const type = url.searchParams.get('type');
const isUpdateMode = mode === 'update' || (!!token && type === 'recovery');

if (!isUpdateMode) return Astro.redirect('/login');
---

<Layout title="traverse — reset password">
  <ResetPasswordScreen client:load />
</Layout>
