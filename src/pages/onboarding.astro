---
import Layout from '../layouts/Layout.astro';
import OnboardingPageContent from '../components/onboarding/OnboardingPageContent';
import { createServerAuth } from '../lib/auth/simple-multi-user';

const serverAuth = createServerAuth(Astro.cookies);
const user = await serverAuth.getUser();
if (!user) return Astro.redirect('/login');

const preferences = await serverAuth.getUserPreferences(user.id);
const prefs = (preferences ?? {}) as Record<string, unknown>;

const onboardingCompletedAt = typeof prefs.onboarding_completed_at === 'string' ? prefs.onboarding_completed_at : null;
const presets = (prefs.onboarding_presets ?? {}) as Record<string, unknown>;
const hasPhase2 = !!presets.phase_2;
const phase2EligibleAt = typeof prefs.phase2_eligible_at === 'string' ? prefs.phase2_eligible_at : null;

let initialPhase: 1 | 2 = 1;
let showIntro = true;

if (!onboardingCompletedAt) {
  initialPhase = 1;
  showIntro = true;
} else if (phase2EligibleAt && !hasPhase2) {
  initialPhase = 2;
  showIntro = false;
} else {
  return Astro.redirect('/today');
}

const rawTheme = prefs.theme as string | undefined;
const theme = (rawTheme === 'dark' || rawTheme === 'midnight' || rawTheme === 'lamp')
  ? 'lamp' as const
  : 'daylight' as const;
const density = prefs.density === 'roomy' ? 'roomy' as const : 'standard' as const;
const motion = prefs.motion !== 'off';
---

<Layout title="traverse — onboarding">
  <OnboardingPageContent client:load initialPhase={initialPhase} showIntro={showIntro} theme={theme} density={density} motion={motion} />
</Layout>
