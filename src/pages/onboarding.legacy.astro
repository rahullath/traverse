---
import { createServerClient } from '../lib/supabase/server';

const supabase = createServerClient(Astro.cookies);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (authError || !user) {
  return Astro.redirect('/login');
}

const { data: preferences } = await supabase
  .from('user_preferences')
  .select('*')
  .eq('user_id', user.id)
  .maybeSingle();

if (preferences) {
  return Astro.redirect('/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Onboarding - MeshOS</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      background: linear-gradient(160deg, #020617 0%, #0f172a 55%, #083344 100%);
      color: #e2e8f0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    }
    .shell {
      max-width: 860px;
      margin: 0 auto;
      padding: 28px 20px 60px;
    }
    .card {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(148, 163, 184, 0.22);
      border-radius: 18px;
      padding: 24px;
      backdrop-filter: blur(6px);
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 14px;
    }
    @media (min-width: 760px) {
      .grid { grid-template-columns: 1fr 1fr; }
    }
    .field {
      display: grid;
      gap: 6px;
    }
    label { font-weight: 600; color: #cbd5e1; }
    select, input {
      background: rgba(30, 41, 59, 0.75);
      border: 1px solid rgba(148, 163, 184, 0.35);
      border-radius: 10px;
      color: #e2e8f0;
      padding: 10px 12px;
      font-size: 14px;
    }
    .btn {
      width: 100%;
      margin-top: 14px;
      background: linear-gradient(120deg, #0891b2, #0f766e);
      color: #ecfeff;
      border: 0;
      border-radius: 12px;
      padding: 12px 16px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn:disabled { opacity: 0.7; cursor: not-allowed; }
    .meta {
      margin-top: 10px;
      font-size: 13px;
      color: #94a3b8;
      text-align: center;
    }
  </style>
</head>
<body>
  <main class="shell">
    <div class="card" style="margin-bottom: 16px;">
      <p style="text-transform: uppercase; letter-spacing: .18em; color: #67e8f9; font-size: 11px; margin: 0 0 8px;">
        Setup
      </p>
      <h1 style="margin: 0 0 8px; font-size: clamp(26px, 4vw, 38px); color: #f8fafc;">
        Build your first stable day
      </h1>
      <p style="margin: 0; color: #cbd5e1;">
        Quick onboarding for executive-function support. No pressure, no optimization theater.
      </p>
    </div>

    <form id="onboarding-form" class="card" action="/api/user/complete-onboarding" method="POST">
      <div class="grid">
        <div class="field">
          <label for="primary_goal">1. What should this app solve first?</label>
          <select id="primary_goal" name="primary_goal" required>
            <option value="" disabled selected>Select one</option>
            <option value="activation">Help me start at all</option>
            <option value="leaving_on_time">Help me leave on time</option>
            <option value="panic_reduction">Reduce panic and overload</option>
            <option value="sleep_regularity">Stabilize sleep/wake timing</option>
          </select>
        </div>

        <div class="field">
          <label for="keystone_activity">2. Keystone activity (first action)</label>
          <input id="keystone_activity" name="keystone_activity" type="text" placeholder="e.g. Leave bed, shower, meds" required />
        </div>

        <div class="field">
          <label for="activation_chain_minutes">3. Typical activation chain length (minutes)</label>
          <input id="activation_chain_minutes" name="activation_chain_minutes" type="number" min="5" max="240" step="5" value="45" required />
        </div>

        <div class="field">
          <label for="infeasible_response">4. If plan becomes infeasible, default response?</label>
          <select id="infeasible_response" name="infeasible_response" required>
            <option value="alternatives">Show alternatives first</option>
            <option value="strict_skip">Strict skip guidance</option>
          </select>
        </div>

        <div class="field">
          <label for="wake_window_start">5. Wake window start</label>
          <input id="wake_window_start" name="wake_window_start" type="time" value="07:00" required />
        </div>

        <div class="field">
          <label for="wake_window_end">6. Wake window end</label>
          <input id="wake_window_end" name="wake_window_end" type="time" value="09:00" required />
        </div>

        <div class="field">
          <label for="sleep_window_start">7. Sleep window start</label>
          <input id="sleep_window_start" name="sleep_window_start" type="time" value="22:30" required />
        </div>

        <div class="field">
          <label for="sleep_window_end">8. Sleep window end</label>
          <input id="sleep_window_end" name="sleep_window_end" type="time" value="00:30" required />
        </div>

        <div class="field">
          <label for="min_sleep_hours">9. Minimum sleep target (hours)</label>
          <input id="min_sleep_hours" name="min_sleep_hours" type="number" min="4" max="12" step="0.5" value="7.5" required />
        </div>

        <div class="field">
          <label for="first_location_label">10. First reusable location label</label>
          <input id="first_location_label" name="first_location_label" type="text" placeholder="University, Workplace, Home" required />
        </div>

        <div class="field">
          <label for="first_location_travel_minutes">11. Total travel minutes to that label</label>
          <input id="first_location_travel_minutes" name="first_location_travel_minutes" type="number" min="0" max="480" step="1" value="20" required />
        </div>

        <div class="field">
          <label for="first_location_departure_slots">12. Departure slots (optional, comma separated)</label>
          <input id="first_location_departure_slots" name="first_location_departure_slots" type="text" placeholder="12:27, 12:47" />
        </div>

        <input type="hidden" name="commitments" value="none" />
        <input type="hidden" name="starting_difficulty" value="starting" />
        <input type="hidden" name="structure_style" value="balanced" />
        <input type="hidden" name="usual_wake_time" value="07:00" />
      </div>

      <button type="submit" id="submit-btn" class="btn">
        Save Phase 1 and Continue
      </button>
      <p class="meta">Phase 2 appears after your first successful day to tune anchors, lateness, and prompt intensity.</p>
    </form>
  </main>

  <script>
    document.getElementById('onboarding-form')?.addEventListener('submit', () => {
      const submitBtn = document.getElementById('submit-btn');
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.textContent = 'Saving setup...';
      }
    });
  </script>
</body>
</html>
