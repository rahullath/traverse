SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
GEMINI_API_KEY=your_gemini_api_key

# Google Calendar OAuth
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Calendar API. Add redirect URI: https://yourdomain.com/api/calendar/google/callback


# Microsoft Outlook / Office 365 OAuth
# Create at: https://portal.azure.com → App registrations → New registration
# Add redirect URI: https://yourdomain.com/api/calendar/outlook/callback
# Required API permissions: Calendars.Read, Calendars.ReadWrite, offline_access, User.Read
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:4321/api/calendar/outlook/callback

# Public site URL (used to build redirect URIs when *_REDIRECT_URI not set)
SITE=http://localhost:4321

# Triage Mirror Feature Flags
# Set to 'true' or 'false' to enable/disable features
TRIAGE_MIRROR_ENABLED=true
STATE_DECLARATION_ENABLED=true
INLINE_EDITING_ENABLED=true
STATELESS_RECALC_ENABLED=true

# Triage Mirror Performance Timeouts (milliseconds)
# RECALC_TIMEOUT_MS: Maximum time for plan recalculation (default: 4000ms)
RECALC_TIMEOUT_MS=4000
# RUNWAY_CALC_TIMEOUT_MS: Maximum time for runway calculation (default: 100ms)
RUNWAY_CALC_TIMEOUT_MS=100
# TRIAGE_KEYSTONE_TIMEOUT_MS: Maximum time for keystone identification (default: 50ms)
TRIAGE_KEYSTONE_TIMEOUT_MS=50
